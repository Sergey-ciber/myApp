# Скопируйте в .env и подставьте свои значения:  copy .env.example .env

# --- База данных (контейнер) ---
POSTGRES_DB=taskmanager
POSTGRES_USER=postgres
# Обязательно смените!
POSTGRES_PASSWORD=change-me-strong-password

# --- Backend ---
# Секрет для подписи JWT, минимум 32 символа.
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=change-me-please-32-chars-minimum-secret-value

# Публичный адрес, по которому открывается приложение.
# Это же значение браузер присылает в заголовке Origin, поэтому без него
# запросы POST/PUT/PATCH будут падать с 403.
# Примеры: http://203.0.113.10   https://tasks.example.com
CORS_ORIGINS=http://CHANGE-ME-SERVER-IP

# --- Frontend ---
# Порт, на котором nginx слушает на хосте (80 для http, 443 если TLS терминируется тут)
HTTP_PORT=80
