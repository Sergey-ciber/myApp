# Скопируйте в .env и подставьте свои значения:  copy .env.example .env

# --- База данных (контейнер) ---
POSTGRES_DB=taskmanager
POSTGRES_USER=postgres
# Обязательно смените!
POSTGRES_PASSWORD=change-me-strong-password

# --- Backend ---
# Секрет для подписи JWT, минимум 32 символа.
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=change-me-please-32-chars-minimum-secret-value

# Публичный адрес, по которому открывается приложение.
# Это же значение браузер присылает в заголовке Origin, поэтому без него
# запросы POST/PUT/PATCH будут падать с 403.
# Примеры: http://203.0.113.10   https://tasks.example.com
CORS_ORIGINS=http://CHANGE-ME-SERVER-IP

# Публичный адрес приложения для ссылки в письме восстановления пароля.
# Должен открываться у пользователя (схема + домен + порт, если не 80/443).
# Если оставить пустым — берётся первый адрес из CORS_ORIGINS.
APP_BASE_URL=

# --- Email (восстановление пароля) ---
# SMTP-сервер. Если MAIL_HOST пуст, письма не отправляются.
# Примеры:
#   Яндекс:  MAIL_HOST=smtp.yandex.ru  MAIL_PORT=465 MAIL_SMTP_SSL=true MAIL_SMTP_STARTTLS=false
#   Mail.ru: MAIL_HOST=smtp.mail.ru   MAIL_PORT=465 MAIL_SMTP_SSL=true MAIL_SMTP_STARTTLS=false
#   Gmail:   MAIL_HOST=smtp.gmail.com MAIL_PORT=587 MAIL_SMTP_SSL=false MAIL_SMTP_STARTTLS=true
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Должен быть разрешён SMTP-провайдером (обычно совпадает с MAIL_USERNAME).
MAIL_FROM=no-reply@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_SSL=false
# Время жизни ссылки сброса и лимиты запросов (необязательно).
# PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# PASSWORD_RESET_RATE_LIMIT_MAX=5
# PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=15

# --- Frontend ---
# Порт, на котором nginx слушает на хосте (80 для http, 443 если TLS терминируется тут)
HTTP_PORT=80
